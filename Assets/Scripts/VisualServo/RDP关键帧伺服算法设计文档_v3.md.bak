## 4. 系统集成架构

### 4.1 类结构图

```
┌─────────────────────────────────────────────────────────────────────────┐
│                        v3.0 类结构图                                     │
├─────────────────────────────────────────────────────────────────────────┤
│  ┌─────────────────────────────────────────────────────────────────┐   │
│  │                    OnlineRDPServoController                      │   │
│  │                    (在线RDP伺服主控制器)                          │   │
│  ├─────────────────────────────────────────────────────────────────┤   │
│  │ 配置:                                                            │   │
│  │   csvFilePath, rdpPositionEpsilon, enableErrorPropagation       │   │
│  │ 组件:                                                            │   │
│  │   singlePointServo, rdpExtractor, errorPropagation              │   │
│  │ 方法:                                                            │   │
│  │   StartOnlineRDPServo(), StopServo(), ServoToKeyframe()         │   │
│  └─────────────────────────────────────────────────────────────────┘   │
│                    ┌───────────────┼───────────────┐                   │
│                    ▼               ▼               ▼                   │
│  ┌──────────────────┐  ┌──────────────────┐  ┌──────────────────────┐ │
│  │ RDPKeyframe      │  │ ErrorPropagation │  │ VisualServo          │ │
│  │ Extractor (C#)   │  │ Manager          │  │ Compensation         │ │
│  └──────────────────┘  └──────────────────┘  └──────────────────────┘ │
└─────────────────────────────────────────────────────────────────────────┘
```

### 4.2 主控制器完整实现

```csharp
using System;
using System.Collections;
using UnityEngine;
using handeye;

namespace VisualServo
{
    /// <summary>
    /// 在线RDP视觉伺服控制器 (v3.0)
    /// 快捷键: R-开始, Y-暂停/继续, U-停止
    /// </summary>
    public class OnlineRDPServoController : MonoBehaviour
    {
        [Header("轨迹文件配置")]
        public string csvFilePath = "TrackerRecordings/trajectory.csv";
        
        [Header("RDP 关键帧提取配置")]
        [Range(0.3f, 2.0f)] public float rdpPositionEpsilon = 0.8f;
        [Range(1f, 15f)] public float rdpRotationEpsilon = 5.0f;
        [Range(1, 20)] public int minKeyframeInterval = 2;
        [Range(20, 200)] public int maxKeyframeInterval = 50;
        
        [Header("误差传递配置")]
        public bool enableErrorPropagation = true;
        [Range(0.5f, 1.0f)] public float errorSmoothingFactor = 0.8f;
        [Range(10f, 100f)] public float maxPositionCorrectionMm = 50f;
        
        [Header("组件引用")]
        public VisualServoCompensationController singlePointServo;
        
        // 内部状态
        private RDPKeyframeExtractor _rdpExtractor;
        private ErrorPropagationManager _errorPropagation;
        private KeyframeExtractionResult _extractionResult;
        private Coroutine _servoCoroutine;
        private bool _isRunning, _isPaused;
        private int _currentKeyframeIndex;
        private System.Diagnostics.Stopwatch _stopwatch;
        
        public event Action<int, int, float> OnKeyframeComplete;
        public event Action<bool, float> OnTrajectoryComplete;
        
        void Awake()
        {
            _rdpExtractor = new RDPKeyframeExtractor(
                rdpPositionEpsilon, rdpRotationEpsilon,
                minKeyframeInterval, maxKeyframeInterval);
            _errorPropagation = new ErrorPropagationManager {
                SmoothingFactor = errorSmoothingFactor,
                MaxPositionCorrection = maxPositionCorrectionMm / 1000f
            };
            _stopwatch = new System.Diagnostics.Stopwatch();
        }
        
        void Update()
        {
            if (Input.GetKeyDown(KeyCode.R)) StartOnlineRDPServo();
            if (Input.GetKeyDown(KeyCode.Y)) TogglePause();
            if (Input.GetKeyDown(KeyCode.U)) StopServo();
        }
        
        public void StartOnlineRDPServo()
        {
            if (_isRunning) return;
            _servoCoroutine = StartCoroutine(OnlineRDPServoCoroutine());
        }
        
        public void StopServo()
        {
            if (_servoCoroutine != null) StopCoroutine(_servoCoroutine);
            singlePointServo?.StopCompensation();
            _isRunning = _isPaused = false;
        }
        
        public void TogglePause() { if (_isRunning) _isPaused = !_isPaused; }
        
        private IEnumerator OnlineRDPServoCoroutine()
        {
            _isRunning = true;
            _stopwatch.Restart();
            
            // Phase 1: 加载轨迹并提取关键帧
            _extractionResult = _rdpExtractor.ExtractKeyframes(csvFilePath);
            if (_extractionResult == null) { _isRunning = false; yield break; }
            int total = _extractionResult.KeyframeIndices.Length;
            
            // Phase 2: 初始化误差传递
            _errorPropagation.Reset();
            
            // Phase 3: 首帧定位 (MoveJ)
            singlePointServo.skipMoveJ = false;
            singlePointServo.enableTargetOffset = true;
            yield return ServoToKeyframe(_extractionResult.GetKeyframeData(0), KeyframeType.FirstFrame);
            
            // Phase 4: 关键帧循环伺服
            for (_currentKeyframeIndex = 1; _currentKeyframeIndex < total; _currentKeyframeIndex++)
            {
                while (_isPaused) yield return null;
                
                var kf = _extractionResult.GetKeyframeData(_currentKeyframeIndex);
                var kfType = DetermineKeyframeType(_extractionResult, _currentKeyframeIndex, total);
                
                singlePointServo.skipMoveJ = true;
                singlePointServo.enableTargetOffset = false;
                yield return ServoToKeyframe(kf, kfType);
                
                OnKeyframeComplete?.Invoke(_currentKeyframeIndex, total, 
                    (_currentKeyframeIndex + 1f) / total * 100f);
            }
            
            // Phase 5: 完成
            _stopwatch.Stop();
            _isRunning = false;
            OnTrajectoryComplete?.Invoke(true, (float)_stopwatch.Elapsed.TotalSeconds);
        }
        
        private IEnumerator ServoToKeyframe(KeyframeData kf, KeyframeType kfType)
        {
            float threshold = GetPositionThresholdMm(_currentKeyframeIndex, 
                _extractionResult.KeyframeIndices.Length, kfType);
            int maxIter = GetMaxIterations(kfType);
            
            // 应用误差前馈
            if (enableErrorPropagation && _currentKeyframeIndex > 0)
                CalculateCompensatedTarget(kf.TrackerPosition, kf.TrackerRotation,
                    _errorPropagation, out _, out _);
            
            singlePointServo.maxIterations = maxIter;
            singlePointServo.positionThreshold = threshold / 1000f;
            singlePointServo.SetTargetPose(kf.TrackerPosition, 
                PoseErrorCalculator.QuaternionToRotationVector(kf.TrackerRotation));
            singlePointServo.StartCompensation();
            
            while (singlePointServo.IsCompensating()) yield return null;
            
            // 更新误差传递修正量
            if (enableErrorPropagation)
            {
                var tcp = ur_data_processing.UR_Control_Data;
                _errorPropagation.UpdateCorrection(kf.TrackerPosition, kf.TrackerRotation,
                    new Vector3((float)tcp.x, (float)tcp.y, (float)tcp.z),
                    new Vector3((float)tcp.rx, (float)tcp.ry, (float)tcp.rz));
            }
        }
        
        private int GetMaxIterations(KeyframeType t) => t switch {
            KeyframeType.FirstFrame => 450,
            KeyframeType.LastFrame => 300,
            KeyframeType.CornerPoint => 100,
            _ => 50
        };
    }
}
```

---

## 5. 异常处理与安全机制

### 5.1 修正量发散保护

如果系统误差突然变大（如Tracker被遮挡），修正量可能异常。需要设置限幅和异常检测：

```csharp
/// <summary>
/// 异常处理配置
/// </summary>
public class SafetyConfig
{
    public float MaxPositionCorrectionMm = 50f;   // 最大位置修正量
    public float MaxRotationCorrectionDeg = 15f;  // 最大姿态修正量
    public int MaxConsecutiveFailures = 3;        // 最大连续失败次数
    public float TrackerLostTimeoutSec = 2.0f;    // Tracker丢失超时
}

/// <summary>
/// 检查修正量是否在安全范围内
/// </summary>
public bool ValidateAndClampCorrection(ref Vector3 posCorrection, ref Quaternion rotCorrection)
{
    bool isValid = true;
    
    // 位置修正量检查
    float posMagnitudeMm = posCorrection.magnitude * 1000f;
    if (posMagnitudeMm > MaxPositionCorrectionMm)
    {
        Debug.LogWarning($"[安全保护] 位置修正量过大: {posMagnitudeMm:F1}mm > {MaxPositionCorrectionMm}mm");
        posCorrection = Vector3.ClampMagnitude(posCorrection, MaxPositionCorrectionMm / 1000f);
        isValid = false;
    }
    
    // 姿态修正量检查
    float rotAngleDeg = Quaternion.Angle(Quaternion.identity, rotCorrection);
    if (rotAngleDeg > MaxRotationCorrectionDeg)
    {
        Debug.LogWarning($"[安全保护] 姿态修正量过大: {rotAngleDeg:F1}° > {MaxRotationCorrectionDeg}°");
        rotCorrection = Quaternion.Slerp(Quaternion.identity, rotCorrection, 
            MaxRotationCorrectionDeg / rotAngleDeg);
        isValid = false;
    }
    
    return isValid;
}

/// <summary>
/// 检测修正量跳变 (异常突变)
/// </summary>
public bool DetectCorrectionJump(Vector3 newCorrection, Vector3 lastCorrection, float jumpThresholdMm = 10f)
{
    float jump = (newCorrection - lastCorrection).magnitude * 1000f;
    if (jump > jumpThresholdMm)
    {
        Debug.LogWarning($"[异常检测] 修正量跳变: {jump:F1}mm > {jumpThresholdMm}mm, 可能Tracker异常");
        return true;
    }
    return false;
}
```

### 5.2 伺服超时策略

在 v3.0 中，为了保证流畅性，伺服过程不能无限等待：

```csharp
/// <summary>
/// 带超时的伺服等待
/// </summary>
private IEnumerator WaitForServoWithTimeout(KeyframeType kfType)
{
    float timeout = GetTimeoutSec(kfType);
    float startTime = Time.time;
    
    while (singlePointServo.IsCompensating())
    {
        if (Time.time - startTime > timeout)
        {
            Debug.LogWarning($"[超时] 关键帧 {_currentKeyframeIndex} 伺服超时 ({timeout}s)");
            singlePointServo.StopCompensation();
            
            // 记录超时信息，但不阻塞流程
            _servoStats.TimeoutCount++;
            break;
        }
        yield return null;
    }
}

/// <summary>
/// 获取关键帧超时时间
/// </summary>
private float GetTimeoutSec(KeyframeType kfType) => kfType switch
{
    KeyframeType.FirstFrame => 10.0f,  // 首帧允许较长时间
    KeyframeType.LastFrame => 5.0f,    // 终帧确保收敛
    KeyframeType.CornerPoint => 2.0f,  // 拐点较短时间
    _ => 0.5f                          // 中间点快速超时
};
```

### 5.3 Tracker丢失处理

```csharp
/// <summary>
/// Tracker有效性检查
/// </summary>
private bool IsTrackerValid()
{
    // 检查Tracker是否被遮挡或丢失
    if (!trackerObject.activeSelf || !trackerObject.GetComponent<SteamVR_TrackedObject>().isValid)
    {
        Debug.LogError("[Tracker丢失] 等待重新捕获...");
        return false;
    }
    return true;
}

/// <summary>
/// 等待Tracker恢复
/// </summary>
private IEnumerator WaitForTrackerRecovery(float timeoutSec)
{
    float startTime = Time.time;
    while (!IsTrackerValid())
    {
        if (Time.time - startTime > timeoutSec)
        {
            Debug.LogError("[严重错误] Tracker长时间丢失，中止伺服");
            StopServo();
            yield break;
        }
        yield return new WaitForSeconds(0.1f);
    }
    Debug.Log("[Tracker恢复] 继续执行");
}
```

---

## 6. 性能对比预测

基于 1163 帧示例轨迹：

| 阶段 | 动作 | 耗时估计 |
|------|------|----------|
| **RDP提取** | 算法计算 | 0.2s |
| **运动执行** | 60个关键帧移动 | 13s (与原始轨迹一致) |
| **视觉伺服** | 60次微调 (每次<0.1s) | 6s |
| **总计** | **单次完成** | **~19.2s** |

**结论**：相比 v2.0 的 31s，v3.0 进一步提升了 38% 的效率，且操作流程简化为“一键运行”。

---

## 7. 总结

v3.0 算法通过 **在线误差传递** 机制，成功解决了 RDP 伺服“断续”和“耗时”的痛点。它将机器人的每一次伺服结果都转化为对未来的“经验”，使得机器人在运行过程中越来越准，实现了**速度与精度的最佳平衡**。

