# URScript - 从动捕数据生成的Movel轨迹
# 位置单位已从毫米转换为米
# 姿态使用恒定的旋转矢量: [rx, ry, rz]

def trajectory_program():
  # 初始姿态(旋转矢量表示) - 请根据实际情况修改
  # 例如: rx=0, ry=3.14159(180度绕Y轴), rz=0
  global rx = 0.0
  global ry = 3.14159
  global rz = 0.0
  
  # 运动参数
  global vel = 0.1  # 速度 (m/s)
  global acc = 0.3  # 加速度 (m/s^2)
  
  textmsg("开始执行轨迹...")
  
  # 采样的Movel指令 (每隔10行采样一次,共约400个点)
